{{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
  <div class="space-y-2">
    {{ form_label(form.email, null, {'label_attr': {'class': 'font-medium text-gray-700'}}) }}
    {{ form_widget(form.email, {'attr': {'class': 'w-full border-gray-300 rounded p-2'}}) }}
  </div>

  <div class="space-y-2">
    {{ form_label(form.roles, null, {'label_attr': {'class': 'font-medium text-gray-700'}}) }}
    {{ form_widget(form.roles, {'attr': {'class': 'space-x-2'}}) }}
  </div>

  <div class="space-y-2">
    {{ form_label(form.name, null, {'label_attr': {'class': 'font-medium text-gray-700'}}) }}
    {{ form_widget(form.name, {'attr': {'class': 'w-full border-gray-300 rounded p-2'}}) }}
  </div>

  <div class="space-y-2">
    {{ form_label(form.createdAt, null, {'label_attr': {'class': 'font-medium text-gray-700'}}) }}
    {{ form_widget(form.createdAt, {'attr': {'class': 'w-full border-gray-300 rounded p-2'}}) }}
  </div>

  <button class="px-5 py-2 bg-blue-600 text-white rounded shadow hover:bg-blue-700 transition">
    {{ button_label|default('Save') }}
  </button>
{{ form_end(form) }}
