{% extends 'base.html.twig' %}

{% block title %}
  👤 User Details
{% endblock %}

{% block body %}
  <div class="bg-white shadow-xl rounded-lg p-6 max-w-lg mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">👤 User Details</h1>

    <div class="space-y-4 text-sm">
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase">ID</p>
        <p class="text-gray-800">{{ user.id }}</p>
      </div>

      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase">Email</p>
        <p class="text-gray-800">{{ user.email }}</p>
      </div>

      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase">Roles</p>
        <div class="flex flex-wrap gap-2 mt-1">
          {% for role in user.roles %}
            <span class="px-2 py-1 bg-blue-100 text-blue-600 text-xs rounded">{{ role }}</span>
          {% else %}
            <span class="text-gray-400">No roles</span>
          {% endfor %}
        </div>
      </div>

      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase">Name</p>
        <p class="text-gray-800">{{ user.name }}</p>
      </div>

      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase">Created At</p>
        <p class="text-gray-800">{{ user.createdAt ? user.createdAt|date('M d, Y H:i') : '-' }}</p>
      </div>
    </div>

    <div class="flex space-x-3 mt-6">
      <a href="{{ path('app_user_index') }}" class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300 transition">⬅ Back</a>
      <a href="{{ path('app_user_edit', { id: user.id }) }}" class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 transition">✏️ Edit</a>
      {{ include('user/_delete_form.html.twig') }}
    </div>
  </div>
{% endblock %}
