{% extends 'base.html.twig' %}

{% block title %}
  ✏️ Edit User
{% endblock %}

{% block body %}
  <div class="bg-white shadow-xl rounded-lg p-6 max-w-2xl mx-auto">
    <h1 class="text-2xl font-bold text-gray-800 mb-6 flex items-center"><span class="mr-2">✏️</span> Edit User</h1>

    {{ form_start(form, { attr: { class: 'space-y-6' } }) }}

    <!-- Email -->
    <div>{{ form_label(form.email, 'Email', { label_attr: { class: 'block text-sm font-semibold text-gray-700 mb-2' } }) }}
      {{ form_widget(form.email, { attr: { class: 'w-full border rounded px-3 py-2 focus:ring focus:ring-blue-200' } }) }}
      {{ form_errors(form.email) }}</div>

    <!-- Roles -->
    <div>
      {{ form_label(form.roles, 'Roles', { label_attr: { class: 'block text-sm font-semibold text-gray-700 mb-2' } }) }}
      <div class="flex flex-wrap gap-3">
        {% for child in form.roles %}
          <label class="flex items-center space-x-2 px-3 py-1 border rounded-lg shadow-sm cursor-pointer hover:bg-gray-50">
            {{ form_widget(child, { attr: { class: 'rounded text-blue-600 focus:ring-blue-500' } }) }}
            <span class="text-gray-700 text-sm">{{ child.vars.label }}</span>
          </label>
        {% endfor %}
      </div>
      {{ form_errors(form.roles) }}
    </div>

    <!-- Name -->
    <div>{{ form_label(form.name, 'Name', { label_attr: { class: 'block text-sm font-semibold text-gray-700 mb-2' } }) }}
      {{ form_widget(form.name, { attr: { class: 'w-full border rounded px-3 py-2 focus:ring focus:ring-blue-200' } }) }}
      {{ form_errors(form.name) }}</div>

    <!-- Created At -->
    <div>{{ form_label(form.createdAt, 'Created At', { label_attr: { class: 'block text-sm font-semibold text-gray-700 mb-2' } }) }}
      {{ form_widget(form.createdAt, { attr: { class: 'w-full border rounded px-3 py-2 focus:ring focus:ring-blue-200' } }) }}
      {{ form_errors(form.createdAt) }}</div>

    <!-- Submit -->
    <div class="flex space-x-3">
      <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">💾 Update</button>
      <a href="{{ path('app_user_index') }}" class="px-4 py-2 bg-gray-200 rounded hover:bg-gray-300 transition">⬅ Back</a>
    </div>

    {{ form_end(form) }}

    <div class="mt-4">{{ include('user/_delete_form.html.twig') }}</div>
  </div>
{% endblock %}
