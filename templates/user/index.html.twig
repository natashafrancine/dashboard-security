{% extends 'base.html.twig' %}

{% block title %}
  👥 User Management
{% endblock %}

{% block body %}
  <div class="bg-white shadow-xl rounded-lg p-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold text-gray-800">👥 User Management</h1>
      <a href="{{ path('app_user_new') }}" class="px-5 py-2 bg-green-500 text-white font-medium rounded-lg shadow hover:bg-green-600 transition">➕ Create New</a>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 rounded-lg shadow">
        <thead class="bg-gradient-to-r from-gray-100 to-gray-200">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">ID</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Email</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Roles</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Name</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Created At</th>
            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-700 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100 text-sm">
          {% for user in users %}
            <tr class="hover:bg-gray-50 transition">
              <td class="px-6 py-4 text-gray-800 font-medium">{{ user.id }}</td>
              <td class="px-6 py-4 text-gray-700">{{ user.email }}</td>
              <td class="px-6 py-4">
                {% for role in user.roles %}
                  <span class="inline-block px-2 py-1 mr-1 bg-blue-100 text-blue-600 text-xs font-semibold rounded-full">{{ role|replace({ ROLE_USER: '👤 User', ROLE_ADMIN: '⭐ Admin' }) }}</span>
                {% else %}
                  <span class="text-gray-400">No roles</span>
                {% endfor %}
              </td>
              <td class="px-6 py-4">{{ user.name }}</td>
              <td class="px-6 py-4 text-gray-500">{{ user.createdAt ? user.createdAt|date('M d, Y H:i') : '-' }}</td>
              <td class="px-6 py-4 flex space-x-2">
                <a href="{{ path('app_user_show', { id: user.id }) }}" class="px-3 py-1 text-xs font-semibold text-blue-600 bg-blue-100 rounded hover:bg-blue-200 transition">👁 Show</a>
                <a href="{{ path('app_user_edit', { id: user.id }) }}" class="px-3 py-1 text-xs font-semibold text-yellow-600 bg-yellow-100 rounded hover:bg-yellow-200 transition">✏️ Edit</a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6" class="text-center py-6 text-gray-500 italic">No users found</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}
