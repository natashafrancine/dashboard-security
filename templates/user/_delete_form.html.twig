<form method="post" action="{{ path('app_user_delete', { id: user.id }) }}" class="inline-block" onsubmit="return confirm('Are you sure you want to delete this user?');">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}" />
  <button class="px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600 transition">🗑 Delete</button>
</form>
